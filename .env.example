# Copy the Postgres connection string from your database provider and require TLS.
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT=30s
DATABASE_MAX_CONNS=10
MODELRAIL_BOOTSTRAP_API_KEY=
# Optional: set an OpenRouter key to use a real model. If blank, ModelRail uses the mock provider.
OPENROUTER_API_KEY=
# Optional: defaults to OpenRouter's automatic free router (picks the best available free model).
OPENROUTER_MODEL=openrouter/free
# Optional for normal tasks. Required for signed webhooks; use 32 random bytes encoded as hex.
WEBHOOK_ENCRYPTION_KEY=
MODELRAIL_ADDR=:8080
SHUTDOWN_TIMEOUT=20s
TASK_TIMEOUT=2m
WORKER_COUNT=2
WORKER_LEASE_SECONDS=45
WORKER_HEARTBEAT_SECONDS=10
RATE_LIMIT_PER_MINUTE=120
TASK_MAX_INPUT_BYTES=1048576
TASK_RETENTION_DAYS=30
